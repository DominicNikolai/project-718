---
const BOX_SIDES = ['front', 'back', 'left', 'right', 'top', 'bottom'] as const;

const baseFaces = BOX_SIDES.map(side => `c-face base-${side}`);
const lidFaces = BOX_SIDES.map(side => `c-face lid-${side}`);
const latchFaces = BOX_SIDES.map(side => `latch-f latch-${side}`);
---

<div class='mc-environment'>
  <div class='mc-chest-wrapper'>
    <input
      type='file'
      id='mc-file'
      class='mc-file-input'
      aria-label='Select file'
    />

    <div class='mc-chest'>
      <div class='chest-part chest-base'>
        {baseFaces.map(className => <div class={className} />)}
      </div>

      <div class='chest-part chest-lid'>
        {lidFaces.map(className => <div class={className} />)}

        <div class='mc-latch'>
          {latchFaces.map(className => <div class={className} />)}
        </div>
      </div>
    </div>

    <div id='mc-text' class='mc-chest-text' aria-live='polite'>SELECT FILE</div>
  </div>
</div>

<style is:global>
  .mc-environment {
    --w: 140px;
    --d: 140px;
    --h-base: 100px;
    --h-lid: 40px;

    --mc-border: #251a10;
    --mc-wood: #825425;
    --mc-wood-light: #996531;
    --mc-wood-dark: #593615;

    --mc-latch-light: #d1d1d1;
    --mc-latch-base: #8f8f8f;
    --mc-latch-dark: #565656;
    --mc-latch-outline: #1a1a1a;

    --mc-void: #050302;
    --mc-hi: #ffff55;
    --mc-label: #aaaaaa;
    --mc-shadow: #151515;

    min-block-size: 100svb;
    padding-block: 40px;
    display: flex;
    justify-content: center;
    align-items: center;

    .mc-chest-wrapper {
      position: relative;
      inline-size: 280px;
      block-size: 280px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      perspective: 1200px;
      margin-block-start: 100px;
    }

    .mc-file-input {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      opacity: 0;
      z-index: 100;
      cursor: pointer;

      &:hover ~ .mc-chest .chest-lid,
      &:focus-visible ~ .mc-chest .chest-lid {
        transform: rotateX(100deg);
      }

      &:active ~ .mc-chest .chest-lid {
        transform: rotateX(110deg);
      }

      &:hover ~ .mc-chest-text,
      &:focus-visible ~ .mc-chest-text {
        color: var(--mc-hi);
        transform: translateY(-2px);
      }
    }

    .mc-chest {
      position: relative;
      inline-size: var(--w);
      block-size: calc(var(--h-base) + var(--h-lid));
      transform-style: preserve-3d;
      transform: rotateX(-24deg) rotateY(-40deg);
      pointer-events: none;
    }

    .chest-part {
      --box-w: var(--w);
      --box-d: var(--d);

      position: absolute;
      inset-inline-start: 0;
      inline-size: var(--w);
      transform-style: preserve-3d;
    }

    .chest-base {
      --box-h: var(--h-base);

      inset-block-start: var(--h-lid);
      block-size: var(--h-base);
    }

    .chest-lid {
      --box-h: var(--h-lid);

      inset-block-start: 0;
      block-size: var(--h-lid);
      transform-origin: 50% 100% calc(var(--d) / -2);
      transition: transform 0.45s cubic-bezier(0.2, 1.2, 0.4, 1);
    }

    .c-face,
    .latch-f {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      margin-block-start: calc(var(--fh) / -2);
      margin-inline-start: calc(var(--fw) / -2);
      inline-size: var(--fw);
      block-size: var(--fh);
    }

    .base-front,
    .base-back,
    .lid-front,
    .lid-back,
    .latch-front,
    .latch-back {
      --fw: var(--box-w);
      --fh: var(--box-h);
    }

    .base-left,
    .base-right,
    .lid-left,
    .lid-right,
    .latch-left,
    .latch-right {
      --fw: var(--box-d);
      --fh: var(--box-h);
    }

    .base-top,
    .base-bottom,
    .lid-top,
    .lid-bottom,
    .latch-top,
    .latch-bottom {
      --fw: var(--box-w);
      --fh: var(--box-d);
    }

    .base-front,
    .lid-front,
    .latch-front {
      transform: translateZ(calc(var(--box-d) / 2));
    }

    .base-back,
    .lid-back,
    .latch-back {
      transform: rotateY(180deg) translateZ(calc(var(--box-d) / 2));
    }

    .base-left,
    .lid-left,
    .latch-left {
      transform: rotateY(-90deg) translateZ(calc(var(--box-d) / 2));
    }

    .base-right,
    .lid-right,
    .latch-right {
      transform: rotateY(90deg) translateZ(calc(var(--box-d) / 2));
    }

    .base-top,
    .lid-top,
    .latch-top {
      transform: translateY(calc((var(--box-d) - var(--box-h)) / 2))
        rotateX(90deg) translateZ(calc(var(--box-d) / 2));
    }

    .base-bottom,
    .lid-bottom,
    .latch-bottom {
      transform: translateY(calc((var(--box-h) - var(--box-d)) / 2))
        rotateX(-90deg) translateZ(calc(var(--box-d) / 2));
    }

    .mc-latch {
      --lw: 20px;
      --lh: 40px;
      --ld: 10px;
      --box-w: var(--lw);
      --box-h: var(--lh);
      --box-d: var(--ld);

      position: absolute;
      inline-size: var(--lw);
      block-size: var(--lh);
      inset-inline-start: calc(50% - var(--lw) / 2);
      inset-block-start: calc(var(--h-lid) - var(--lh) / 2);
      transform-style: preserve-3d;
      transform: translateZ(calc(var(--d) / 2 + 5px));
    }

    .c-face {
      background-color: var(--mc-wood);
      border: 10px solid var(--mc-border);
      background-image:
        repeating-linear-gradient(
          to bottom,
          var(--mc-wood-light) 0px,
          var(--mc-wood-light) 4px,
          transparent 4px,
          transparent 16px,
          var(--mc-wood-dark) 16px,
          var(--mc-wood-dark) 20px
        ),
        repeating-linear-gradient(
          to right,
          transparent 0px,
          transparent 10px,
          rgba(0, 0, 0, 0.06) 10px,
          rgba(0, 0, 0, 0.06) 20px,
          rgba(255, 255, 255, 0.06) 20px,
          rgba(255, 255, 255, 0.06) 40px,
          rgba(0, 0, 0, 0.12) 40px,
          rgba(0, 0, 0, 0.12) 50px
        );
    }

    .base-front,
    .lid-front {
      filter: brightness(1);
    }

    .base-left,
    .lid-left {
      filter: brightness(0.85);
    }

    .base-right,
    .lid-right {
      filter: brightness(0.65);
    }

    .base-back,
    .lid-back {
      filter: brightness(0.5);
    }

    .lid-top {
      filter: brightness(1.2);
    }

    .base-bottom {
      background: var(--mc-border);
    }

    .base-top {
      background-color: var(--mc-void);
      background-image: none;
      box-shadow: inset 0 0 40px var(--mc-void);
    }

    .latch-f {
      background-color: var(--mc-latch-base);
      border: 2px solid var(--mc-latch-outline);
    }

    .latch-front {
      background: linear-gradient(
        to bottom,
        var(--mc-latch-light) 0px,
        var(--mc-latch-light) 10px,
        var(--mc-latch-base) 10px,
        var(--mc-latch-base) 28px,
        var(--mc-latch-dark) 28px
      );
    }

    .latch-left,
    .latch-right {
      background: var(--mc-latch-dark);
    }

    .latch-top {
      background: var(--mc-latch-light);
    }

    .latch-bottom {
      background: var(--mc-latch-dark);
    }

    .mc-chest-text {
      margin-block-start: 60px;
      font-family: 'Press Start 2P', monospace;
      color: var(--mc-label);
      font-size: 14px;
      text-align: center;
      letter-spacing: 0.05em;
      text-shadow: 2px 2px 0 var(--mc-shadow);
      transition:
        transform 0.2s,
        color 0.2s;
      max-inline-size: 280px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('.mc-file-input');
  const text = document.querySelector<HTMLElement>('.mc-chest-text');

  if (input && text) {
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      text.textContent = file ? file.name.toUpperCase() : 'SELECT FILE';
    });
  }
</script>
